{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "python3 build.py --production --offline",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self'; img-src 'self' data: blob: https://pqmgtvfeavidoecwbvwy.supabase.co; font-src 'self'; connect-src 'self' https://pqmgtvfeavidoecwbvwy.supabase.co; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Speculation-Rules",
          "value": "\"/speculation-rules.json\""
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/speculation-rules.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/speculationrules+json"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/pridat-aktualitu/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "mapa-webu"
        }
      ],
      "destination": "/mapa-webu/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "cookies"
        }
      ],
      "destination": "/ochrana-osobnich-udaju/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "hledej"
        }
      ],
      "destination": "/hledat/",
      "permanent": true
    },
    {
      "source": "/cs/tiraz/",
      "destination": "/prohlaseni-o-pristupnosti/",
      "permanent": true
    },
    {
      "source": "/cs/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/novinky/",
      "destination": "/aktuality/",
      "permanent": true
    },
    {
      "source": "/o-skole/dokumenty-skoly/skolni-rad-platny-od-1-9-2026-6.html",
      "destination": "/o-skole/dokumenty-skoly/",
      "permanent": true
    },
    {
      "source": "/o-skole/dokumenty-skoly/svp-8.html",
      "destination": "/o-skole/dokumenty-skoly/",
      "permanent": true
    },
    {
      "source": "/o-skole/dokumenty-skoly/vyrocni-zpravy-5.html",
      "destination": "/o-skole/dokumenty-skoly/",
      "permanent": true
    },
    {
      "source": "/o-skole/fotogalerie/zahranicni-zajezdy/:path*",
      "destination": "/skolni-akce/zahranicni-zajezdy/",
      "permanent": true
    },
    {
      "source": "/skolni-akce/besedy-a-exkurze-archiv/:path*",
      "destination": "/aktuality/akce/",
      "permanent": true
    },
    {
      "source": "/skolni-akce/kulturni-akce/:path*",
      "destination": "/aktuality/akce/",
      "permanent": true
    },
    {
      "source": "/studium/predmety/zemepis/zemepis-ucebnice-52cs.html",
      "destination": "/studium/predmety/zemepis/",
      "permanent": true
    }
  ],
  "functions": {
    "api/page.py": {
      "includeFiles": "{build.py,content/**,static/img/**}"
    }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/page/?path=/:path*"
    }
  ]
}
